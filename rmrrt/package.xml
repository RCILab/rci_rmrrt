<?xml version="1.0"?>
<package format="2">
  <name>rmrrt</name>
  <version>1.0.0</version>
  <description>
    RMRRT: Riemannian Barrier Metric RRT. RRT-Connect on equality-constrained manifolds whose steering and
    node selection use a barrier metric built from the inequality constraints.
  </description>
  <maintainer email="kingtyphoon@khu.ac.kr">Minhyeong Kang</maintainer>
  <author>Minhyeong Kang</author>
  <author>Sanghyun Kim</author>
  <license>BSD-3-Clause</license>
  <url type="website">https://rcilab.khu.ac.kr/rmrrt/</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_msgs</depend>
  <depend>geometric_shapes</depend>
  <depend>shape_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>boost</depend>

  <exec_depend>rviz</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>panda_moveit_config</exec_depend>
  <exec_depend>dual_panda_moveit_config</exec_depend>
  <exec_depend>assembly_moveit_config</exec_depend>

  <test_depend>rosunit</test_depend>
</package>
