Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 0.25
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: moveit_rviz_plugin/PlanningScene
      Enabled: true
      Move Group Namespace: ""
      Name: Scene
      Planning Scene Topic: /rmrrt_view/scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 0.8
        Scene Color: 130; 130; 140
        Scene Display Time: 0.2
        Show Scene Geometry: true
        Voxel Coloring: Z-Axis
        Voxel Rendering: Occupied Voxels
      Scene Robot:
        Attached Body Color: 150; 50; 150
        Robot Alpha: 1
        Show Robot Collision: false
        Show Robot Visual: false
      Value: true
    - Class: moveit_rviz_plugin/Trajectory
      Color Enabled: false
      Enabled: true
      Interrupt Display: true
      Loop Animation: true
      Name: Path
      Robot Alpha: 1
      Robot Description: robot_description
      Show Robot Collision: false
      Show Robot Visual: true
      Show Trail: false
      State Display Time: 1x
      Trail Step Size: 10
      Trajectory Topic: /rmrrt_view/path
      Use Sim Time: false
      Value: true
    - Attached Body Color: 60; 200; 60
      Class: moveit_rviz_plugin/RobotState
      Enabled: true
      Name: Start
      Robot Alpha: 0.25
      Robot Description: robot_description
      Robot State Topic: /rmrrt_view/start
      Show All Links: true
      Show Highlights: true
      Value: true
    - Attached Body Color: 50; 130; 255
      Class: moveit_rviz_plugin/RobotState
      Enabled: true
      Name: Goal
      Robot Alpha: 0.25
      Robot Description: robot_description
      Robot State Topic: /rmrrt_view/goal
      Show All Links: true
      Show Highlights: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /rmrrt_view/search
      Name: Search
      Namespaces: {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 3.5
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.6
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
  Width: 1400
